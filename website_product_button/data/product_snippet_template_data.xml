<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="template_website_product_price" 
            inherit_id="website_sale.dynamic_filter_template_product_product_view_detail" >

            <xpath expr="//div[hasclass('o_carousel_product_card_body')]" position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>

            <xpath expr="//div[hasclass('d-flex')]" position="inside">
                <a class="btn btn-primary" t-att-href="record.website_url">
                    More information
                </a>
            </xpath>
  
        </template>
    </data>
</odoo>
