<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_invoice_qty_number" model="ir.ui.view">
        <field name="name">sale.order.invoice.qty.number.form (Invoice Qty Number)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="invoice_number_count" optional='hide'/>
            </xpath>            
        </field>
    </record>
</odoo>
