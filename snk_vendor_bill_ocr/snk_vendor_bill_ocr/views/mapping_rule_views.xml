<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_bill_ocr_mapping_rule_tree" model="ir.ui.view">
        <field name="name">snk.vendor.bill.ocr.mapping.rule.tree</field>
        <field name="model">snk.vendor.bill.ocr.mapping.rule</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <!-- Debe estar disponible sin restricción de grupo porque varios
                     dominios de esta vista dependen de company_id. -->
                <field name="company_id" invisible="1"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="match_type"/>
                <field name="pattern"/>
                <field name="product_id" optional="show"/>
                <field name="account_id" optional="show"/>
                <field name="tax_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_vendor_bill_ocr_mapping_rule_form" model="ir.ui.view">
        <field name="name">snk.vendor.bill.ocr.mapping.rule.form</field>
        <field name="model">snk.vendor.bill.ocr.mapping.rule</field>
        <field name="arch" type="xml">
            <form string="Regla OCR de factura">
                <sheet>
                    <!-- Copia técnica sin restricción de grupo para los dominios. -->
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="match_type"/>
                            <field name="pattern"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_bill_ocr_mapping_rule" model="ir.actions.act_window">
        <field name="name">Reglas OCR de facturas</field>
        <field name="res_model">snk.vendor.bill.ocr.mapping.rule</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_vendor_bill_ocr_mapping_rule"
              name="Reglas OCR de facturas"
              parent="account.account_invoicing_menu"
              action="action_vendor_bill_ocr_mapping_rule"
              groups="account.group_account_manager"
              sequence="95"/>
</odoo>
