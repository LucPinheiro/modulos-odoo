<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_vendor_bill_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.form.vendor.bill.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_digitalization']" position="after">
                <h2 groups="base.group_system">Digitalización Azure de facturas de proveedor</h2>
                <div class="row mt16 o_settings_container" id="snk_vendor_bill_ocr_settings" groups="base.group_system">
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="vendor_bill_ocr_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="vendor_bill_ocr_enabled" string="OCR de facturas de proveedor en Community"/>
                            <div class="text-muted">
                                Crea facturas de proveedor en borrador desde PDF o fotografías mediante Azure Document Intelligence prebuilt-invoice.
                            </div>
                            <div class="content-group" attrs="{'invisible': [('vendor_bill_ocr_enabled', '=', False)]}">
                                <div class="row mt16">
                                    <label for="vendor_bill_ocr_provider" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_provider" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_azure_endpoint" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_azure_endpoint" class="oe_inline" placeholder="https://mi-recurso.cognitiveservices.azure.com"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_azure_api_version" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_azure_api_version" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_azure_key" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_azure_key" password="True" class="oe_inline" placeholder="Vacío conserva la actual"/>
                                    <span class="ms-2 text-success" attrs="{'invisible': [('vendor_bill_ocr_key_configured', '=', False)]}">
                                        <i class="fa fa-check"/> Clave guardada
                                    </span>
                                    <field name="vendor_bill_ocr_key_configured" invisible="1"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_clear_key" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_clear_key" class="oe_inline"/>
                                </div>

                                <h3 class="mt16">Contabilización</h3>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_default_account_id" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_default_account_id" class="oe_inline" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_default_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_default_product_id" class="oe_inline" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_auto_create_vendor" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_auto_create_vendor" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_auto_tax" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_auto_tax" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_prices_include_tax" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_prices_include_tax" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_require_review" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_require_review" class="oe_inline"/>
                                </div>

                                <h3 class="mt16">Validaciones y costes</h3>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_confidence_threshold" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_confidence_threshold" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_tax_rate_tolerance" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_tax_rate_tolerance" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_amount_tolerance" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_amount_tolerance" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_max_file_mb" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_max_file_mb" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_max_pages" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_max_pages" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_daily_limit" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_daily_limit" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_monthly_limit" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_monthly_limit" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_max_attempts" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_max_attempts" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_batch_size" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_batch_size" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_max_age_days" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_max_age_days" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_future_days" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_future_days" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_max_amount" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_max_amount" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_bill_ocr_store_raw_response" class="col-lg-3 o_light_label"/>
                                    <field name="vendor_bill_ocr_store_raw_response" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <div class="col-lg-3"/>
                                    <button name="action_vendor_bill_ocr_validate_configuration"
                                            type="object" string="Validar configuración"
                                            class="btn btn-secondary"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

