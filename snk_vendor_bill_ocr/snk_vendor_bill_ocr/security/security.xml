<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_vendor_bill_ocr_user" model="res.groups">
        <field name="name">Cargador OCR de facturas de compra</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_vendor_bill_ocr_purchase_create" model="ir.rule">
        <field name="name">OCR: crear solo facturas de compra</field>
        <field name="model_id" ref="model_account_move"/>
        <field name="domain_force">[('move_type', '=', 'in_invoice')]</field>
        <field name="groups" eval="[(4, ref('group_vendor_bill_ocr_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_vendor_bill_ocr_purchase_own_rw" model="ir.rule">
        <field name="name">OCR: ver y editar solo facturas propias</field>
        <field name="model_id" ref="model_account_move"/>
        <field name="domain_force">[('move_type', '=', 'in_invoice'), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_vendor_bill_ocr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_vendor_bill_ocr_move_line_own_rw" model="ir.rule">
        <field name="name">OCR: líneas de facturas propias</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('move_id.move_type', '=', 'in_invoice'), ('move_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_vendor_bill_ocr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_vendor_bill_ocr_mapping_company" model="ir.rule">
        <field name="name">Reglas OCR de facturas por compañía</field>
        <field name="model_id" ref="model_snk_vendor_bill_ocr_mapping_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>

    <record id="rule_vendor_bill_ocr_usage_company" model="ir.rule">
        <field name="name">Consumo OCR de facturas por compañía</field>
        <field name="model_id" ref="model_snk_vendor_bill_ocr_usage_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>

