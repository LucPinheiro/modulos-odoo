<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_product_description_wizard_form" model="ir.ui.view">
        <field name="name">ecommerce.product.description.translation.import.wizard.form</field>
        <field name="model">ecommerce.product.description.translation.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar traducciones HTML">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="text-muted">Columnas: id, lang, short_description_product, full_description_product. Las celdas vacías no se importan.</div>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_import_product_description_wizard" model="ir.actions.act_window">
        <field name="name">Importar traducciones HTML</field>
        <field name="res_model">ecommerce.product.description.translation.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,kanban</field>
    </record>
</odoo>
