<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_views_form" model="ir.ui.view"> 
        <field name="name">project.task.form (Task Billable Mangement)</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="task_status" /> 
            </xpath>
        </field>
    </record>

    <record id="project_task_views_kanban" model="ir.ui.view">
        <field name="name">project.task.kanban (Task Billable Mangement)</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/> 
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="quick_create">false</attribute>
            </kanban>
        </field>
    </record>
</odoo>
